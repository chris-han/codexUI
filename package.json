{
  "name": "codexapp",
  "version": "0.1.60",
  "description": "A lightweight web interface for Codex that runs on top of the Codex app-server, allowing remote access from any browser",
  "type": "module",
  "license": "MIT",
  "author": "Pavel Voronin, Igor Levochkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/friuns2/codexui.git"
  },
  "homepage": "https://github.com/friuns2/codexui#readme",
  "bugs": {
    "url": "https://github.com/friuns2/codexui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codex",
    "openai",
    "web-ui",
    "remote",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codexapp": "dist-cli/index.js",
    "codexui": "dist-cli/index.js"
  },
  "files": [
    "dist/",
    "dist-cli/"
  ],
  "scripts": {
    "dev": "bun install && vite",
    "dev:open": "bun run build:cli && sh -c 'bun run dev & VPID=$!; node dist-cli/index.js --open-project \"${1:-.}\"; wait $VPID' --",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:cli": "tsup",
    "build": "bun run build:frontend && bun run build:cli",
    "preview": "vite preview",
    "skills:with-settings": "node ./codex-ui-react/scripts/run-skills-with-settings.mjs",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "firebase": "^12.2.1",
    "highlight.js": "^11.11.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34"
}
